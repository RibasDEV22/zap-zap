function applyUpdate() {
  const btn = document.getElementById('btn-update-now');
  btn.innerText = "Iniciando Download...";

  // URL permanente que o GitHub redireciona para a última release
  const latestExeUrl = "https://github.com/RibasDEV22/zap-zap/releases/latest/download/setup.exe";

  // Dispara o download imediato do setup.exe
  const a = document.createElement('a');
  a.href = latestExeUrl;
  a.download = 'setup.exe';
  document.body.appendChild(a);
  a.click();
  a.remove();
}
